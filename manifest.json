{
    "schemaVersion": "1.9.0",
    "acapPackageConf": {
        "setup": {
            "appName": "widget_wizard",
            "friendlyName": "Widget Wizard",
            "vendor": "Axis Communications",
            "embeddedSdkVersion": "3.0",
            "architecture": "aarch64",
            "user": {
                "username": "sdk",
                "group": "sdk"
            },
            "runMode": "never",
            "version": "1.5.4",
            "compatibleOsVersions": [
                {
                    "min": "11",
                    "max": "13"
                }
            ]
        },
        "configuration": {
            "paramConfig": [
                {
                    "name": "ApplicationRunning",
                    "type": "yes_no",
                    "default": "no"
                }
            ],
            "settingPage": "index.html",
            "reverseProxy": [
                {
                    "apiPath": "system-stats-ws",
                    "apiType": "ws",
                    "target": "ws://127.0.0.1:9000",
                    "access": "admin"
                }
            ]
        }
    }
}
